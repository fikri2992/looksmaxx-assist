# Copy to .env.local. Sandbox only: the code never calls live PayPal.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Reasoning model access (openrouter.ai)
OPENROUTER_API_KEY=

# Optional: Channel3 works on its free tier without a key
CHANNEL3_API_KEY=
# Second sandbox business account that plays the store (the payee). Email only, never a password.
STORE_SANDBOX_EMAIL=
