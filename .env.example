# Copy to .env.local. Sandbox only: the code never calls live PayPal.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Second sandbox business account that plays the store (the payee). Email only, never a password.
STORE_SANDBOX_EMAIL=

# OpenAI: chat, vision, tools, looks and voice. Each call is priced conservatively against a daily cap (USD).
OPENAI_API_KEY=
OPENAI_DAILY_CAP=10

# Fallback model access when OPENAI_API_KEY is empty (openrouter.ai)
OPENROUTER_API_KEY=

# Optional: Channel3 works on its free tier without a key
CHANNEL3_API_KEY=

# Hosting: the public base URL (for PayPal return links), and PUBLIC_DEMO=1 so reset returns to the demo persona
PUBLIC_URL=
PUBLIC_DEMO=

# Video mode: generic labels instead of product names, brands, stores and package photos (display only)
MASK_BRANDS=
