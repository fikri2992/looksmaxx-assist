 "policies": [
  {
   "version": 1,
   "createdBy": "seed",
   "reason": "Starting rules",
   "rules": [
    {
     "id": "avoid-list",
     "when": [
      {
       "fact": "user.avoidHit",
       "op": "notEmpty"
      }
     ],
     "then": "veto",
     "because": "It contains something you reacted to before."
    },
    {
     "id": "already-own",
     "when": [
      {
       "fact": "need.ownedCovering",
       "op": "is",
       "value": true
      }
     ],
     "then": "veto",
     "because": "You already own something that covers this."
    },
    {
     "id": "too-cheap",
     "when": [
      {
       "fact": "price.vsLow",
       "op": "lt",
       "value": 0.7
      }
     ],
     "then": "ask",
     "because": "Far below its own price history: likely a wrong match, a different size or a fake."
    },
    {
     "id": "over-item-limit",
     "when": [
      {
       "fact": "product.price",
       "op": "gtFact",
       "value": "rules.askAbove"
      }
     ],
     "then": "ask",
     "because": "Above your per-item limit."
    },
    {
     "id": "over-budget",
     "when": [
      {
       "fact": "product.price",
       "op": "gtFact",
       "value": "budget.monthLeft"
      }
     ],
     "then": "ask",
     "because": "Would pass your monthly budget."
    },
    {
     "id": "thin-history",
     "when": [
      {
       "fact": "price.days",
       "op": "lt",
       "value": 14
      }
     ],
     "then": "ask",
     "because": "Less than 14 days of prices, so I can’t judge the price."
    },
    {
     "id": "fake-was-price",
     "when": [
      {
       "fact": "product.wasPrice",
       "op": "gtFact",
       "value": "price.high"
      },
      {
       "fact": "price.days",
       "op": "gte",
       "value": 14
      },
      {
       "fact": "need.daysLeft",
       "op": "gt",
       "value": 7
      }
     ],
     "then": "wait",
     "because": "The “was” price never appeared in its history: the discount is fake, and you have time."
    },
    {
     "id": "wait-for-low",
     "when": [
      {
       "fact": "price.vsLow",
       "op": "gt",
       "value": 1.15
      },
      {
       "fact": "need.daysLeft",
       "op": "gt",
       "value": 7
      }
     ],
     "then": "wait",
     "because": "It was clearly cheaper recently, and you have time before you run out."
    },
    {
     "id": "fair-and-needed",
     "when": [
      {
       "fact": "price.vsLow",
       "op": "lte",
       "value": 1.15
      },
      {
       "fact": "price.days",
       "op": "gte",
       "value": 14
      },
      {
       "fact": "product.inStock",
       "op": "is",
       "value": true
      }
     ],
     "then": "buy",
     "because": "Fair against its own history, and you need it."
    },
    {
     "id": "running-out",
     "when": [
      {
       "fact": "need.daysLeft",
       "op": "lte",
       "value": 7
      },
      {
       "fact": "price.days",
       "op": "gte",
       "value": 14
      },
      {
       "fact": "product.inStock",
       "op": "is",
       "value": true
      }
     ],
     "then": "buy",
     "because": "You run out within a week."
